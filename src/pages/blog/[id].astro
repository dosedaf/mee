---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — DOSEDAF`}>

  <main style="max-width: 780px; margin: 0 auto;">
    
    <div style="padding: 0 1.75rem;">
      <article style="margin-top: 1rem; margin-bottom: 3.5rem;">
        
        <!-- Header -->
        <header style="margin-bottom: 2rem; border-bottom: 2px solid #111111; padding-bottom: 0.75rem; display: block;">
          <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 0.75rem;">
          <a href={import.meta.env.BASE_URL} style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); text-decoration: none; text-transform: uppercase; letter-spacing: 0.05em; display: inline-block;">
            &#8629; TRANSMISSIONS
          </a>
            </a>
            <time style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); display: inline-block;">
              {post.data.date.toISOString().split('T')[0]}
            </time>
          </div>

          <h1 style="font-family: var(--font-serif); font-size: 1.6rem; font-weight: 600; color: #111111; margin: 0 0 0.4rem 0; line-height: 1.25; display: block; width: 100%;">
            {post.data.title}
          </h1>

          {post.data.description && (
            <p style="font-size: 0.78rem; color: #555555; font-family: var(--font-mono); margin: 0; display: block; width: 100%;">
              &#8627; {post.data.description}
            </p>
          )}
        </header>

        <!-- Post Body -->
        <div class="post-content">
          <Content />
        </div>

      </article>
    </div>

  </main>

</BaseLayout>

<style is:global>
  /* Base Body Text - Matched to Description Style */
  .post-content {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: #444444;
  }

  .post-content p {
    margin-bottom: 1.25rem;
  }

  /* Monospace Headings with Section Dividers */
  .post-content h2 {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111111;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.35rem;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }

  .post-content h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Lists in Monospace */
  .post-content ul, .post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    font-family: var(--font-mono);
  }

  .post-content li {
    margin-bottom: 0.4rem;
  }

  .post-content li strong {
    color: #111111;
    font-weight: 700;
  }

  /* Minimal Blockquotes */
  .post-content blockquote {
    margin: 1.25rem 0;
    padding: 0.4rem 0 0.4rem 0.85rem;
    border-left: 2px solid #111111;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #555555;
    background: #fcfcfc;
  }

  /* Inline Code Spans */
  .post-content :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: #f4f4f4;
    color: #111111;
    padding: 0.12rem 0.35rem;
    border: 1px solid #e0e0e0;
    border-radius: 2px;
  }

  /* Code Blocks */
  .post-content pre {
    padding: 1rem 1.25rem;
    border: 1px solid #111111;
    background: #121212 !important;
    border-radius: 0;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .post-content pre code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    background: transparent !important;
    padding: 0;
    border: none;
  }
</style>
