---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = [
  { 
    repo: "Kyasshu", 
    category: "Go / Systems",
    logo: "https://raw.githubusercontent.com/dosedaf/kyasshu/main/logo.jpg",
    desc: "Lightweight, high-performance in-memory caching system written in Go.",
    link: "https://github.com/dosedaf/kyasshu"
  },
  { 
    repo: "Yellow Trip", 
    category: "Data Engineering",
    logo: "https://raw.githubusercontent.com/dosedaf/yellow_trip/main/logo.jpg",
    desc: "NYC Yellow Taxi trip data processing engine and analytical pipeline.",
    link: "https://github.com/dosedaf/yellow_trip"
    },
  { 
    repo: "Tilik", 
    category: "Data Engineering",
    logo: "https://raw.githubusercontent.com/dosedaf/tilik/main/logo.png",
    desc: "Data platform for Indonesian public-sector data",
    link: "https://github.com/dosedaf/tilik"
  }
];
---

<BaseLayout title="dosedaf">

  <main style="max-width: 780px; margin: 0 auto;">

    <Hero bgImage="/images/realrim.jpg" posX="center" posY="center" desc="PEPTIDE BACKED DATA ENGINEER" />

    <div style="padding: 0 1.75rem;">
      <section style="margin-top: 1.5rem; margin-bottom: 2.25rem;">
        <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; border-bottom: 2px solid #111111; padding-bottom: 0.35rem;">
          <h2 style="font-size: 0.82rem; font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.12em; color: #111111; text-transform: uppercase;">
            01 / SELECTED WORKS
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {projects.map(proj => (
            <article style="display: flex; flex-direction: column; gap: 0.15rem;">
              <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">
                {proj.category}
              </span>
              
              <div style="display: flex; align-items: center;">
                <a 
                  href={proj.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  style="color: var(--text); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;"
                >
                  <h3 style="font-family: var(--font-serif); font-size: 1.1rem; font-weight: 500; margin: 0;">
                    {proj.repo}
                  </h3>
                  <img 
                    src={proj.logo} 
                    alt={`${proj.repo} logo`} 
                    style="width: 16px; height: 16px; object-fit: cover; " 
                  />
                </a>
              </div>

              <p style="font-size: 0.7rem; color: #444444; line-height: 1.35; font-family: var(--font-mono); margin-top: 0.1rem;">
                &#8627; {proj.desc}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; border-bottom: 2px solid #111111; padding-bottom: 0.35rem;">
          <h2 style="font-size: 0.82rem; font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.12em; color: #111111; text-transform: uppercase;">
            02 / TRANSMISSIONS
          </h2>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} style="text-decoration: none; color: var(--text); display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;">
              <div>
                <h3 style="font-family: var(--font-serif); font-size: 1.1rem; font-weight: 500; margin-bottom: 0.1rem;">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p style="font-size: 0.7rem; color: #555555; font-family: var(--font-mono);">
                    {post.data.description}
                  </p>
                )}
              </div>

              <time style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); white-space: nowrap;">
                {post.data.date.toISOString().split('T')[0]}
              </time>
            </a>
          ))}
        </div>
      </section>
    </div>

  </main>

</BaseLayout>
